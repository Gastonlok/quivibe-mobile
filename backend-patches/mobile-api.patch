+  expect(m.slots).toHaveBeenCalledWith({
+    placeId: "place-a",
+    date: "2026-10-01",
+    partySize: 4,
+  });
+  expect(await response.json()).toMatchObject({
+    quote: { amountMinor: 100, currency: "USD" },
